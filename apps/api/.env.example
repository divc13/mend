# MEND API environment example. Copy to .env and fill locally; never commit secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=4010
PUBLIC_BASE_URL=http://127.0.0.1:4010
# Safe default. For a real testnet run replace the next two lines with:
#   MEND_MODE=LIVE_TESTNET
#   CHAIN_ADAPTER=live
# and set MEND_TESTNET_KEYS_FILE to an absolute path OUTSIDE this repository.
MEND_MODE=REPLAY

# Optional. Without it the API uses the in-memory repository.
# DATABASE_URL=postgres://mend:password@127.0.0.1:5432/mend

CHAIN_ADAPTER=replay
# Preferred LIVE_TESTNET names. The legacy HUB_ACCOUNT / TOKEN_ACCOUNT /
# NEAR_RPC_URL names are still read as fallbacks.
MEND_HUB_ACCOUNT=mend-hub-v2.testnet
MEND_TOKEN_ACCOUNT=mend-usdc.testnet
MEND_RPC_URL=https://rpc.testnet.near.org
HUB_ACCOUNT=mend-hub-v2.testnet
TOKEN_ACCOUNT=mend-usdc.testnet
NEAR_RPC_URL=
# Legacy single signer. The live adapter intentionally does NOT use this; it
# needs the external role key file below.
NEAR_SIGNER_ACCOUNT=
NEAR_SIGNER_SECRET=

# LIVE TESTNET ONLY. Never commit this file and never point MEND_RPC_URL at
# mainnet. The path is supplied by a human and must be outside the repository.
# Example: /Users/you/.mend/testnet/keys.json
# Hosted deployments may instead set MEND_TESTNET_KEYS_JSON_B64 to the base64 of the
# same external JSON file; the API writes it to a private temp file at startup.
MEND_TESTNET_KEYS_FILE=
MEND_TESTNET_KEYS_JSON_B64=
MEND_DEPLOYER_ACCOUNT=mend-deployer.testnet
MEND_STEWARD_ACCOUNT=mend-steward.testnet
MEND_SPONSOR_ACCOUNT=mend-sponsor.testnet
MEND_DAO_ACCOUNT=mend-dao.testnet
MEND_CONTRACTOR_ACCOUNT=mend-contractor-a.testnet
MEND_INSPECTOR_ACCOUNT=mend-inspector.testnet
MEND_ADMIN_ACCOUNT=mend-deployer.testnet

# Testnet onboarding. Wallet creation shells out to near-cli-rs; faucet sends
# 100 mUSDC (test value only) from the deployer role account.
MEND_TESTNET_WALLET_ENABLED=true
MEND_TESTNET_FAUCET_ENABLED=true
MEND_TESTNET_FAUCET_AMOUNT_MICRO=100000000
MEND_TESTNET_FAUCET_COOLDOWN_SECONDS=3600
MEND_TESTNET_WALLET_CREATES_PER_IP_HOUR=3
MEND_TESTNET_FAUCETS_PER_IP_HOUR=10
MEND_NEAR_CLI_PATH=near
MEND_NEAR_CLI_TIMEOUT_MS=120000

# Canonical live scenario runner. Requires every role signer above. The route
# is absent unless MEND_MODE=LIVE_TESTNET and this flag is true.
MEND_LIVE_SCENARIO_ENABLED=false
MEND_LIVE_SCENARIO_TIMEOUT_MS=600000
MEND_LIVE_SCENARIO_COMMIT_SECONDS=90
MEND_LIVE_SCENARIO_REVEAL_SECONDS=60
# auto inspects the deployed hub code. The current shared testnet hub was built
# with the older MEND_BID_V1 commitment; a fresh deployment of this repo is V2.
MEND_LIVE_BID_PAYLOAD_VERSION=auto

EVIDENCE_ADAPTER=local
EVIDENCE_DIR=./.evidence
EVIDENCE_URL_SECRET=replace-with-a-long-random-local-secret
EVIDENCE_URL_TTL_SECONDS=300
EVIDENCE_MAX_BYTES=8388608

# S3-compatible evidence adapter (interface present, not activated in this wave).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Private inference. Leave empty to keep triage honestly UNAVAILABLE.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_TIMEOUT_MS=120000
NEAR_AI_API_KEY=

# 1Click/Intents: mainnet only. Dry previews require INTENTS_ENABLED=true.
# Live execution additionally requires INTENTS_ALLOW_LIVE=true and a per-call
# confirmLive:true. This service never signs or transfers.
INTENTS_ENABLED=false
INTENTS_ALLOW_LIVE=false
INTENTS_API_URL=https://1click.chaindefuser.com
# Partner JWT, server-side only. Never commit or expose it.
INTENTS_API_KEY=

DEMO_RESET_ENABLED=true
DEMO_ADMIN_ACCOUNT=demo-admin.mend.testnet
DEMO_DURABILITY_MINUTES=2
BID_COMMIT_WINDOW_SECONDS=300
BID_REVEAL_WINDOW_SECONDS=300

# Demo role headers. Production must replace these with verified signatures/JWT.
MEND_DEMO_HEADERS=true
MEND_DEFAULT_ACCOUNT=anonymous.mend.testnet
