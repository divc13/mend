# MEND environment template.
#
#   cp infra/env.example infra/.env
#
# infra/.env is gitignored. Never commit it and never put a real credential in
# this template. Only local-only development defaults are pre-filled here.
#
# Legend
#   [LOCAL]   safe/meaningless local default. Override for any shared environment.
#   [HUMAN]   requires a credential, account or approval held by a human.
#             Leave blank until the human supplies it; never invent a value.
#   [OPTIONAL]
#   [MAINNET] must stay disabled for all agent work. Enabling it needs explicit
#             human approval for every transaction (see infra/docs/TESTNET_DEPLOY.md).

# ---------------------------------------------------------------------------
# Runtime / mode separation
# ---------------------------------------------------------------------------
# MEND_MODE is one of: REPLAY, LIVE_TESTNET, MAINNET.
# The local stack defaults to REPLAY so nothing local can be mistaken for a live
# transaction. The UI must render the REPLAY / SIMULATION label from this value.
MEND_ENV=local
MEND_MODE=REPLAY
NODE_ENV=development
LOG_LEVEL=debug
# pretty | json  (use json for hosted/collector environments)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Postgres (read model + private index; never the financial source of truth)
# ---------------------------------------------------------------------------
POSTGRES_USER=mend
POSTGRES_PASSWORD=mend_local_dev_only
POSTGRES_DB=mend
POSTGRES_PORT=5432
# In-network URL used by containers.
DATABASE_URL=postgres://mend:mend_local_dev_only@postgres:5432/mend
# Host-machine URL used by scripts and tools run outside Docker.
DATABASE_URL_HOST=postgres://mend:mend_local_dev_only@localhost:5432/mend

# ---------------------------------------------------------------------------
# Private object storage (MinIO locally; S3-compatible in hosted environments)
# Evidence buckets are private: no anonymous read, signed URLs only.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=mend-local-minio
MINIO_ROOT_PASSWORD=mend-local-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=mend-local-minio
S3_SECRET_ACCESS_KEY=mend-local-minio-secret
S3_BUCKET_EVIDENCE=mend-evidence
S3_BUCKET_ARTIFACTS=mend-artifacts
S3_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Network / ports
# ---------------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000
INDEXER_PORT=4100
INDEXER_INTERNAL_URL=http://indexer:4100
INDEXER_MAX_LAG_BLOCKS=50
WORKER_PORT=4200
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MEND_MODE=REPLAY

# ---------------------------------------------------------------------------
# Demo / deterministic reset (F13)
# Reset routes must be disabled outside local/demo environments.
# ---------------------------------------------------------------------------
DEMO_RESET_ENABLED=true
DEMO_RESET_TOKEN=local-demo-reset-token
DEMO_DURABILITY_INTERVAL_MINUTES=2
DEMO_SEED=canonical
REPLAY_BUNDLE_DIR=fixtures/recorded-responses

# ---------------------------------------------------------------------------
# NEAR testnet (F01-F11)
# All account IDs below are fictional testnet identifiers from the frozen
# canonical fixtures. Nothing here is a credential.
# ---------------------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Optional fallback RPC. Empty disables the fallback path.
NEAR_RPC_FALLBACK_URL=
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
NEAR_HUB_ACCOUNT_ID=mend-hub.testnet
NEAR_TOKEN_ACCOUNT_ID=mend-usdc.testnet
NEAR_DAO_ACCOUNT_ID=mend-dao.sputnikv2.testnet
NEAR_STEWARD_ACCOUNT_ID=steward.mend.testnet
NEAR_SPONSOR_ACCOUNT_ID=sponsor.mend.testnet
NEAR_COORDINATOR_ACCOUNT_ID=coordinator-ai.mend.testnet
NEAR_REVIEWER_ACCOUNT_ID=reviewer-ai.mend.testnet
NEAR_RELAYER_ACCOUNT_ID=relayer.mend.testnet
NEAR_CONTRACTOR_ACCOUNT_IDS=contractor-a.mend.testnet,contractor-b.mend.testnet,contractor-c.mend.testnet
NEAR_INSPECTOR_ACCOUNT_IDS=inspector.mend.testnet,inspector-2.mend.testnet
# Deployer is a human keychain identity; never a raw key in this file.
NEAR_DEPLOYER_ACCOUNT_ID=mend-deployer.testnet
NEAR_CLI_NETWORK=testnet
# Testnet-only funding for newly created accounts/contracts.
NEAR_ACCOUNT_INITIAL_BALANCE=10
NEAR_CONTRACT_INITIAL_BALANCE=30
# WASM artefacts produced by the contracts track (relative to the repo root).
NEAR_HUB_WASM_PATH=contracts/target/wasm32-unknown-unknown/release/mend_hub.wasm
NEAR_TOKEN_WASM_PATH=contracts/target/wasm32-unknown-unknown/release/mend_test_token.wasm
# Contract init/role method names. Provisional defaults are aligned with the
# frozen protocol; they must be confirmed by the contracts track before deploy.
HUB_INIT_METHOD=new
HUB_INITIALIZED_VIEW=is_initialized
HUB_ROLE_METHOD=grant_role
HUB_HAS_ROLE_VIEW=has_role
TOKEN_INIT_METHOD=new
# Optional JSON overrides for contract init. Leave unset for the documented
# defaults in scripts/deploy-testnet.sh. Must match the frozen contract interface.
# TOKEN_INIT_ARGS_JSON=
# HUB_INIT_ARGS_JSON=

# ---------------------------------------------------------------------------
# HUMAN CREDENTIALS — NEAR AI Cloud (F02)
# Server-side only. Never expose to the browser or logs.
# ---------------------------------------------------------------------------
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=near-ai-cloud-default
# [HUMAN] API key + credits. Blank = AI features report "verification unavailable".
NEAR_AI_API_KEY=

# ---------------------------------------------------------------------------
# HUMAN CREDENTIALS — OutLayer deterministic compute (F07)
# ---------------------------------------------------------------------------
OUTLAYER_API_URL=
# [HUMAN] OutLayer credentials / payment setup.
OUTLAYER_API_KEY=
OUTLAYER_CALLBACK_URL=

# ---------------------------------------------------------------------------
# HUMAN CREDENTIALS — NEAR Agent Market (F10)
# ---------------------------------------------------------------------------
AGENT_MARKET_API_URL=
# [HUMAN] Agent Market account, confirmed email and agent token.
AGENT_MARKET_AGENT_TOKEN=

# ---------------------------------------------------------------------------
# HUMAN CREDENTIALS — Sputnik DAO (F04)
# DAO accounts, proposal permissions and a funded testnet balance are human work.
# ---------------------------------------------------------------------------
# [HUMAN] DAO operator account allowed to submit policy proposals.
NEAR_DAO_OPERATOR_ACCOUNT_ID=
DAO_PROPOSAL_GAS_TGAS=100

# ---------------------------------------------------------------------------
# HUMAN CREDENTIALS — RPC providers (optional paid endpoints)
# Public testnet RPC works for local development without a key.
# ---------------------------------------------------------------------------
# [HUMAN] Set when using a keyed/paid RPC endpoint.
NEAR_RPC_API_KEY=
# [HUMAN] Optional keyed FastNEAR/other provider URL.
NEAR_RPC_PROVIDER_URL=

# ---------------------------------------------------------------------------
# Intents / 1Click sponsorship (F05)
# Intents operates on MAINNET only. Dry quotes are the default; a real deposit
# needs separate explicit human approval.
# ---------------------------------------------------------------------------
INTENTS_API_URL=https://1click.chaindefuser.com
# [HUMAN] Optional partner JWT. Without it the disclosed no-JWT fee applies.
INTENTS_JWT=
INTENTS_DRY_RUN_DEFAULT=true

# ---------------------------------------------------------------------------
# MAINNET — disabled by default. Agent work must never enable this.
# [MAINNET] Every mainnet action requires a separate human approval.
# ---------------------------------------------------------------------------
MEND_ALLOW_MAINNET=false
MEND_MAINNET_HUMAN_APPROVED=false
# MAINNET_NEAR_RPC_URL=
# MAINNET_HUB_ACCOUNT_ID=
# MAINNET_TOKEN_ACCOUNT_ID=
# MAINNET_DEPLOYER_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Observability (T08.5). Never log secrets or private evidence.
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# [HUMAN] [OPTIONAL] Error reporting / alert delivery destinations.
SENTRY_DSN=
ALERT_WEBHOOK_URL=
