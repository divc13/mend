{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "apps/api/src/**/*.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": ["node_modules", ".vercel", "apps/web"]
}
