{
  "name": "mend",
  "version": "0.1.0",
  "private": true,
  "description": "MEND — Maintenance with memory. Community asset repair with durable warranties.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "protocol:export": "npm run export --workspace @mend/protocol",
    "test:quality": "npm --prefix tests test",
    "test:e2e": "npm --prefix tests run test:e2e",
    "test:contract:adversarial": "npm --prefix tests run test:contract",
    "test:live": "npm --prefix tests/live run test:live",
    "demo:capture": "node scripts/demo/capture-replay-demo.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
