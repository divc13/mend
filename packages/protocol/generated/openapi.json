{
  "openapi": "3.1.0",
  "info": {
    "title": "MEND API",
    "version": "0.1.0",
    "description": "MEND protocol API. The hub contract is the financial source of truth; Postgres is a read model. AI output is a proposal, never authority to move money."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/v1/modes": {
      "get": {
        "operationId": "getModes",
        "responses": {
          "200": {
            "description": "LIVE_TESTNET | MAINNET | REPLAY"
          }
        }
      }
    },
    "/v1/assets": {
      "get": {
        "operationId": "listAssets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAsset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Asset"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets/{assetId}": {
      "get": {
        "operationId": "getAsset",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports": {
      "post": {
        "operationId": "createReport",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-orders": {
      "get": {
        "operationId": "listWorkOrders",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkOrder"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWorkOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkOrder"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-orders/{workOrderId}": {
      "get": {
        "operationId": "getWorkOrder",
        "parameters": [
          {
            "name": "workOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkOrder"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-orders/{workOrderId}/bids": {
      "get": {
        "operationId": "getBids",
        "parameters": [
          {
            "name": "workOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commitments and (after reveal) reveals"
          }
        }
      }
    },
    "/v1/work-orders/{workOrderId}/score": {
      "get": {
        "operationId": "getScore",
        "parameters": [
          {
            "name": "workOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreExecution"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-orders/{workOrderId}/evidence": {
      "get": {
        "operationId": "getEvidence",
        "parameters": [
          {
            "name": "workOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePackage"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work-orders/{workOrderId}/payments": {
      "get": {
        "operationId": "getPayments",
        "parameters": [
          {
            "name": "workOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    },
    "/v1/intents/quote": {
      "post": {
        "operationId": "quoteIntent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentQuote"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Quote (dry quotes are not payments)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentQuote"
                }
              }
            }
          }
        }
      }
    },
    "/v1/intents/status/{quoteId}": {
      "get": {
        "operationId": "intentStatus",
        "parameters": [
          {
            "name": "quoteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentExecution"
                }
              }
            }
          }
        }
      }
    },
    "/v1/verification/{subjectHash}": {
      "get": {
        "operationId": "getVerification",
        "parameters": [
          {
            "name": "subjectHash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attestation"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Asset": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2,12}-\\d{3}$"
          },
          "publicDescription": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "assetType": {
            "type": "string",
            "enum": [
              "bench",
              "bicycle_rack",
              "fence",
              "door",
              "playground",
              "other"
            ]
          },
          "publicLocation": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "coarseLat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "coarseLng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "area": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "label",
              "coarseLat",
              "coarseLng"
            ],
            "additionalProperties": false
          },
          "passportTokenId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "publicDescription",
          "assetType",
          "publicLocation",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Report": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-\\d{3}$"
          },
          "assetId": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "publicLocation": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "coarseLat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "coarseLng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "area": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "label",
              "coarseLat",
              "coarseLng"
            ],
            "additionalProperties": false
          },
          "preciseLocationRef": {
            "type": "string"
          },
          "reporterCaseLink": {
            "type": "string",
            "minLength": 16
          },
          "redactedMediaHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "perceptualHash": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "exifStripped": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "TRIAGED",
              "CLUSTERED",
              "DUPLICATE",
              "ACCEPTED"
            ]
          },
          "clusterId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "assetId",
          "description",
          "publicLocation",
          "reporterCaseLink",
          "exifStripped",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ReportCluster": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CL-\\d{4}$"
          },
          "reportIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidenceBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "SUGGESTED",
              "CONFIRMED",
              "REJECTED"
            ]
          },
          "confirmedBy": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reportIds",
          "confidenceBps",
          "rationale",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "DaoApproval": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "daoAccount": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "proposalId": {
            "type": "string",
            "pattern": "^\\d{1,10}$"
          },
          "budgetMicro": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "contractorRoster": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
            }
          },
          "inspectorRoster": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
            }
          },
          "policyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "APPROVED",
              "REJECTED",
              "EXPIRED"
            ]
          },
          "approvedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "daoAccount",
          "proposalId",
          "budgetMicro",
          "contractorRoster",
          "inspectorRoster",
          "policyHash",
          "state"
        ],
        "additionalProperties": false
      },
      "WorkOrder": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WO-[A-Z0-9-]+-\\d{4}$"
          },
          "assetId": {
            "type": "string"
          },
          "reportClusterId": {
            "type": "string"
          },
          "scopeHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "daoApprovalId": {
            "type": "string"
          },
          "policyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "budgetMicro": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "POLICY_APPROVED",
              "FUNDED",
              "BIDDING_OPEN",
              "BIDDING_REVEAL",
              "SCORED",
              "AWARDED",
              "IN_PROGRESS",
              "COMPLETION_SUBMITTED",
              "COMPLETION_ACCEPTED",
              "DURABILITY_PENDING",
              "CLOSED",
              "WARRANTY_REOPENED",
              "DISPUTED",
              "CANCELLED",
              "REFUNDED",
              "FUNDING_FAILED",
              "PAUSED"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "LIVE_TESTNET",
              "MAINNET",
              "REPLAY"
            ]
          },
          "awardedBidId": {
            "type": "string"
          },
          "contractorId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "inspectorId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "fundingToken": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "fundingTxHash": {
            "type": "string"
          },
          "durabilityDueAt": {
            "type": "string"
          },
          "reopenCount": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "assetId",
          "reportClusterId",
          "scopeHash",
          "daoApprovalId",
          "policyHash",
          "budgetMicro",
          "status",
          "mode",
          "fundingToken",
          "reopenCount",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "BidCommitment": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workOrderId": {
            "type": "string"
          },
          "bidId": {
            "type": "string",
            "pattern": "^BID-[A-Z]-[A-Z0-9-]+$"
          },
          "contractorId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "commitmentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "committedAt": {
            "type": "string"
          }
        },
        "required": [
          "workOrderId",
          "bidId",
          "contractorId",
          "commitmentHash",
          "committedAt"
        ],
        "additionalProperties": false
      },
      "BidReveal": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workOrderId": {
            "type": "string"
          },
          "bidId": {
            "type": "string"
          },
          "contractorId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
          },
          "priceMicro": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "durationDays": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "warrantyDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "availableInDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "materials": {
            "type": "string",
            "maxLength": 1000
          },
          "materialsScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "evidenceChecklistAccepted": {
            "type": "boolean"
          },
          "nonce": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "revealedAt": {
            "type": "string"
          },
          "commitmentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "workOrderId",
          "bidId",
          "contractorId",
          "priceMicro",
          "durationDays",
          "warrantyDays",
          "availableInDays",
          "materials",
          "materialsScore",
          "evidenceChecklistAccepted",
          "nonce",
          "revealedAt",
          "commitmentHash"
        ],
        "additionalProperties": false
      },
      "ScoreExecution": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workOrderId": {
            "type": "string"
          },
          "policyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "wasmHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ranking": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "bidId": {
                  "type": "string"
                },
                "contractorId": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64,
                  "pattern": "^(([a-z\\d]+[-_])*[a-z\\d]+)(\\.([a-z\\d]+[-_])*[a-z\\d]+)*$"
                },
                "scoreBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "rank",
                "bidId",
                "contractorId",
                "scoreBps"
              ],
              "additionalProperties": false
            }
          },
          "executionRef": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "unavailableReason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workOrderId",
          "policyHash",
          "wasmHash",
          "inputHash",
          "outputHash",
          "ranking",
          "verified",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "EvidencePackage": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workOrderId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "COMPLETION",
              "REMEDIATION",
              "DURABILITY"
            ]
          },
          "evidenceHashes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "checklist": {
